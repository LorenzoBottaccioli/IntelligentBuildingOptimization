                  "type": "tile",
                  "entity": "sensor.outdoor_humidity",
                  "vertical": false
                },
                {
                  "type": "tile",
                  "entity": "sensor.wind_speed",
                  "vertical": false
                },
                {
                  "type": "tile",
                  "entity": "sensor.direct_solar",
                  "vertical": false
                },
                {
                  "type": "heading",
                  "heading": "Result",
                  "heading_style": "title",
                  "icon": "mdi:leaf"
                },
                {
                  "type": "markdown",
                  "content": "{% set c = states('sensor.heating_energy_controlled') | float(0) %}{% set b = states('sensor.heating_energy_baseline') | float(0) %}## {{ ((1 - c / b) * 100) | round(1) if b > 0 else '-' }} %\nheating energy saved by the controller, last run of each ({{ c | round(0) }} against {{ b | round(0) }} kWh)",
                  "grid_options": {
                    "columns": "full",
                    "rows": 3
                  }
                }
              ]
            }
