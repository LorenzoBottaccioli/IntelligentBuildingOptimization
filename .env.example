# Copy this file to .env before running `docker compose up --build`.
# Compose substitutes these into docker-compose.yml; without a .env the
# credentials resolve to empty strings and InfluxDB/Grafana fail to start.

INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
